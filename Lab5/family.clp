(deftemplate father-of (slot father) (slot child))
(deftemplate mother-of (slot mother) (slot child))
(deftemplate male (slot person))
(deftemplate female (slot person))
(deftemplate wife-of (slot wife) (slot husband))
(deftemplate husband-of (slot husband) (slot wife))
(deftemplate parent (slot person) (slot child))
(deftemplate sibling (slot person) (slot other))
(deftemplate brother (slot person) (slot sibling))
(deftemplate sister (slot person) (slot sibling))
(deftemplate uncle (slot person) (slot child))
(deftemplate aunt (slot person) (slot child))
(deftemplate cousin (slot person) (slot other))
(deftemplate grandparent (slot person) (slot child))
(deftemplate grandfather (slot person) (slot child))
(deftemplate grandmother (slot person) (slot child))
(deftemplate ancestor (slot person) (slot descendant))

(defrule father-to-parent
  (declare (salience 30))
  (father-of (father ?p) (child ?c))
  (not (parent (person ?p) (child ?c)))
  => (assert (parent (person ?p) (child ?c))))
(defrule mother-to-parent
  (declare (salience 30))
  (mother-of (mother ?p) (child ?c))
  (not (parent (person ?p) (child ?c)))
  => (assert (parent (person ?p) (child ?c))))
(defrule find-siblings
  (declare (salience 20))
  (parent (person ?p) (child ?a))
  (parent (person ?p) (child ?b&~?a))
  (not (sibling (person ?a) (other ?b)))
  => (assert (sibling (person ?a) (other ?b))))
(defrule find-brother
  (sibling (person ?a) (other ?b)) (male (person ?a))
  (not (brother (person ?a) (sibling ?b)))
  => (assert (brother (person ?a) (sibling ?b))))
(defrule find-sister
  (sibling (person ?a) (other ?b)) (female (person ?a))
  (not (sister (person ?a) (sibling ?b)))
  => (assert (sister (person ?a) (sibling ?b))))
(defrule find-uncle
  (parent (person ?p) (child ?c))
  (brother (person ?u&~?c) (sibling ?p))
  (not (uncle (person ?u) (child ?c)))
  => (assert (uncle (person ?u) (child ?c))))
(defrule find-aunt
  (parent (person ?p) (child ?c))
  (sister (person ?a&~?c) (sibling ?p))
  (not (aunt (person ?a) (child ?c)))
  => (assert (aunt (person ?a) (child ?c))))
(defrule find-uncle-by-marriage
  (parent (person ?p) (child ?c))
  (sibling (person ?a) (other ?p))
  (husband-of (husband ?u&~?c) (wife ?a))
  (not (uncle (person ?u) (child ?c)))
  => (assert (uncle (person ?u) (child ?c))))
(defrule find-aunt-by-marriage
  (parent (person ?p) (child ?c))
  (sibling (person ?u) (other ?p))
  (wife-of (wife ?a&~?c) (husband ?u))
  (not (aunt (person ?a) (child ?c)))
  => (assert (aunt (person ?a) (child ?c))))
(defrule wife-to-husband
  (wife-of (wife ?w) (husband ?h))
  (not (husband-of (husband ?h) (wife ?w)))
  => (assert (husband-of (husband ?h) (wife ?w))))
(defrule husband-to-wife
  (husband-of (husband ?h) (wife ?w))
  (not (wife-of (wife ?w) (husband ?h)))
  => (assert (wife-of (wife ?w) (husband ?h))))
(defrule find-cousins
  (parent (person ?p) (child ?a))
  (sibling (person ?p) (other ?q))
  (parent (person ?q) (child ?b&~?a))
  (not (sibling (person ?a) (other ?b)))
  (not (cousin (person ?a) (other ?b)))
  => (assert (cousin (person ?a) (other ?b))))
(defrule find-grandparent
  (parent (person ?g) (child ?p))
  (parent (person ?p) (child ?c&~?g))
  (not (grandparent (person ?g) (child ?c)))
  => (assert (grandparent (person ?g) (child ?c))))
(defrule find-grandfather
  (grandparent (person ?g) (child ?c)) (male (person ?g))
  (not (grandfather (person ?g) (child ?c)))
  => (assert (grandfather (person ?g) (child ?c))))
(defrule find-grandmother
  (grandparent (person ?g) (child ?c)) (female (person ?g))
  (not (grandmother (person ?g) (child ?c)))
  => (assert (grandmother (person ?g) (child ?c))))
(defrule direct-ancestor
  (parent (person ?p) (child ?c&~?p))
  (not (ancestor (person ?p) (descendant ?c)))
  => (assert (ancestor (person ?p) (descendant ?c))))
(defrule indirect-ancestor
  (parent (person ?a) (child ?p))
  (ancestor (person ?p) (descendant ?c&~?a))
  (not (ancestor (person ?a) (descendant ?c)))
  => (assert (ancestor (person ?a) (descendant ?c))))

; Print only the derived relations requested by the assignment.
(deffunction show-relations ()
  (do-for-all-facts ((?f brother)) TRUE (printout t "brother: " ?f:person " -> " ?f:sibling crlf))
  (do-for-all-facts ((?f sister)) TRUE (printout t "sister: " ?f:person " -> " ?f:sibling crlf))
  (do-for-all-facts ((?f uncle)) TRUE (printout t "uncle: " ?f:person " -> " ?f:child crlf))
  (do-for-all-facts ((?f aunt)) TRUE (printout t "aunt: " ?f:person " -> " ?f:child crlf))
  (do-for-all-facts ((?f cousin)) TRUE (printout t "cousin: " ?f:person " -> " ?f:other crlf))
  (do-for-all-facts ((?f grandparent)) TRUE (printout t "grandparent: " ?f:person " -> " ?f:child crlf))
  (do-for-all-facts ((?f grandfather)) TRUE (printout t "grandfather: " ?f:person " -> " ?f:child crlf))
  (do-for-all-facts ((?f grandmother)) TRUE (printout t "grandmother: " ?f:person " -> " ?f:child crlf))
  (do-for-all-facts ((?f ancestor)) TRUE (printout t "ancestor: " ?f:person " -> " ?f:descendant crlf)))
